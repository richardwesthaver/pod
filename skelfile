;;; pod @ 2024-06-21.02:30:12 -*- mode:skel; -*-
:name "pod"
:author "Richard Westhaver"
:version "0.1.0"
:vc (:hg "https://vc.compiler.company/comp/pod")
:bind ((prefix :env "/usr/local"))
:components
((:containerfile "scratch")
 (:containerfile "alpine")
 (:containerfile "alpine-worker")
 (:containerfile "alpine-infra")
 (:containerfile "archlinux")
 (:containerfile "dev")
 (:containerfile "worker")
 (:containerfile "infra")
 (:containerfile "operator")
 (:containerfile "web")
 (:containerfile "vc")
 (:containerfile "ubuntu")
 (:containerfile "mail")
 (:containerfile "amazon")
 (:containerfile "archriscv"))
:rules
((web ()
      (:build () #$podman build -f Containerfile.web -t web --no-cache --device=/dev/net/tun$#)
      (:run ()
            #$podman run --name web --replace -dt -p 8080:8080 -p 2020:2020 \
            --volume /srv/http:/home/web/www \
            web$#))
 (infra ()
        (:build () #$podman build -f Containerfile.infra -t infra --no-cache$#)
        (:run (infra-sbcl infra-stumpwm infra-emacs infra-rocksdb)))
 (infra-sbcl () #$podman run --replace -dt -v /opt/stash:/usr/local/share/stash:z --name infra-sbcl infra \
             -c "skel build sbcl && skel dist sbcl && sudo cp .stash/sbcl.tar.zst /usr/local/share/stash"$#)
 (infra-stumpwm () #$podman run --replace -dt -v /opt/stash:/usr/local/share/stash:z --name infra-sbcl infra \
                -c "skel build stumpwm && skel dist stumpwm && sudo cp .stash/stumpwm.tar.zst /usr/local/share/stash"$#)
 (infra-emacs () #$podman run --replace -dt -v /opt/stash:/usr/local/share/stash:z --name infra-emacs infra \
              -c "skel build emacs && skel dist emacs && sudo cp .stash/emacs.tar.zst /usr/local/share/stash"$#)
 (infra-rocksdb () #$podman run --replace -dt -v /opt/stash:/usr/local/share/stash:z --name infra-rocksdb infra \
                -c "skel build rocksdb && skel dist rocksdb && sudo cp .stash/rocksdb.tar.zst /usr/local/share/stash"$#)
 (operator ()
           (:build () #$podman build -f Containerfile.operator -t operator --no-cache$#)
           (:run () #$podman run --replace -dt --name operator \
                 -v /opt/stash:/usr/local/share/stash:z \
                 -v /opt/store:/usr/local/share/store:z \
                 operator$#))
 (vc ()
     (:build () #$podman build -f Containerfile.vc -t vc --no-cache$#)
     (:run () #$podman run --name vc --replace -dt -v $HOME/src:/home/vc/src:z -p 8888:8888 vc$#))
 ;; (git ()
 ;;  (:build () #$podman build -f Containerfile.git -t git --no-cache$#)
 ;;  (:run () #$podman run --name git --replace -dt -v $HOME/src/packy:/home/vc/packy:z -p 8889:80 git$#))
 (dev ()
      (:build () #$podman build -f Containerfile.dev -t dev --no-cache$#)
      (:run () #$podman run --name dev --replace -dt dev$#))
 (emacs ()
        (:build () #$podman build -f Containerfile.emacs -t emacs --no-cache$#)
        (:run () #$podman run --name emacs --replace -it emacs$#))
 (org ()
      (:build () #$podman build -f Containerfile.org -t org --no-cache$#))
 (archlinux ()
            (:build () #$podman build -f Containerfile.archlinux -t archlinux --no-cache$#)
            (:run () #$podman run --name archlinux --replace -dt archlinux$#)
            )
 (mail ()
       (:build () #$podman build -f Containerfile.mail -t mail --no-cache$#)
       (:run () #$podman run --name mail --replace -dt -p 8080 mail$#))
 (alpine ()
         (:build () #$podman build -f Containerfile.alpine -t alpine --no-cache$#))
 (alpine-infra ()
               (:build () #$podman build -f Containerfile.alpine-infra -t alpine-infra --no-cache$#)
               (:run () #$podman run --name alpine-infra --replace -dt alpine-infra$#))
 (worker ()
         (:build () #$podman build -f Containerfile.worker -t worker --no-cache$#)
         (:run () #$podman run --name worker --replace -dt worker$#))
 (w1 ()
     (:build () #$buildah build -f Containerfile.w0 -t w0
             c=$(buildah from w0)
             buildah add $c /opt/core/store/packy/src/sbcl.tar.zst /usr/src/
             buildah add $c /opt/core/store/packy/src/core.tar.zst /usr/src/
             buildah add $c /opt/core/store/packy/src/infra.tar.zst /usr/src/
             buildah add $c /opt/core/store/packy/src/home/operator.tar.zst /usr/src/
             buildah run $c mkdir -pv /usr/share/lisp /root/.stash/lisp
             buildah run --workingdir /usr/src/home/ $c -- sh -c 'for i in `find -type f`; do cp -rpvf $i /root/; done'
             buildah run $c apk add sbcl liburing-dev libxkbcommon-dev btrfs-progs-dev libevdev-dev readline-dev
             buildah run --workingdir /usr/src/sbcl $c -- sh make.sh
             buildah run --workingdir /usr/src/sbcl $c -- sh install.sh
             buildah run $c apk del sbcl
             buildah run $c mkdir -pv /usr/src/infra/.stash/src /usr/src/infra/.stash/tmp
             buildah run --network host --workingdir /usr/src/infra/.stash/ $c curl -O https://beta.quicklisp.org/quicklisp.lisp
             buildah run --workingdir /usr/src/infra/ --network host $c sh scripts/quicklisp-install.sh
             buildah run $c sbcl --eval '(ql:quickload :cl-ppcre)' --quit
             buildah commit $c w1$#)
     (:build-sbcl () #$c=$(podman run -dt w1)
                  podman exec -w /usr/src/sbcl $c sh make-shared-library.sh
                  podman exec -w /usr/src/sbcl $c sh make.sh --dynamic-space-size=8Gb --without-gencgc --with-mark-region-gc --fancy
                  podman exec -w /usr/src/sbcl $c mv /usr/src/sbcl /usr/src/infra/.stash/src/
                  podman exec -w /usr/src/infra $c ./scripts/dist-sbcl-binary.sh
                  podman cp $c:/usr/src/infra/.stash/sbcl.tar.zst sbcl.tar.zst
                  podman stop $c$#)
     (:build-rocksdb () #$c=$(podman run -dt w1)
                     podman exec -w /usr/src/infra $c sh scripts/get-rocksdb.sh
                     podman exec -w /usr/src/infra/.stash/src/rocksdb $c make shared_lib DISABLE_JEMALLOC=1
                     podman exec -w /usr/src/infra $c sh scripts/dist-rocksdb-binary.sh
                     podman cp $c:/usr/src/infra/.stash/rocksdb.tar.zst rocksdb.tar.zst
                     podman stop $c$#)
     (:build-blake3 () #$c=$(podman run -dt w1)
                    podman exec -w /usr/src/infra $c sh scripts/get-blake3.sh
                    podman exec -w /usr/src/infra/.stash/src/blake3/c $c cc -shared -O3 -o libblake3.so blake3.c blake3_dispatch.c blake3_portable.c \
                    blake3_sse2_x86-64_unix.S blake3_sse41_x86-64_unix.S blake3_avx2_x86-64_unix.S blake3_avx512_x86-64_unix.S
                    
                    podman exec -w /usr/src/infra $c sh scripts/dist-blake3.sh
                    podman cp $c:/usr/src/infra/.stash/blake3.tar.zst blake3.tar.zst
                    podman stop $c$#)
     (:build-tree-sitter () #$c=$(podman run -dt w1)
                         podman exec -w /usr/src/infra $c sh scripts/get-tree-sitter.sh
                         podman exec -w /usr/src/infra/.stash/src/tree-sitter $c make libtree-sitter.so
                         podman exec -w /usr/src/infra $c sh scripts/dist-tree-sitter.sh
                         podman cp $c:/usr/src/infra/.stash/tree-sitter.tar.zst tree-sitter.tar.zst$#)
     (:build-tree-sitter-langs () #$c=$(podman run -dt w1)
                               podman exec -w /usr/src/infra $c sh scripts/dist-tree-sitter-langs.sh
                               podman cp $c:/usr/src/infra/.stash/tree-sitter-langs.tar.zst tree-sitter-langs.tar.zst$#)
     (:build-core () #$c=$(podman run -dt w1)
                  podman exec -w /usr/src/core/lisp/ffi/tree-sitter $c cc \
                  -g -O2 -Wall -Wno-unused-value -ltree-sitter -shared \
                  alien.c -o ../../../libtree-sitter-alien.so
                  podman exec -w /usr/src/core/lisp/ffi/zstd $c cc \
                  -g -O2 -Wall -Wno-unused-value -lzstd -shared \
                  alien.c -o ../../../libzstd-alien.so
                  podman exec -w /usr/src/core $c cp lib*.so /usr/local/lib/
                  podman exec -w /usr/src/core $c sbcl --eval '(ql:quickload :core)' \
                  --eval '(asdf:make :bin/core)' --quit
                  podman exec -w /usr/src/core $c mv lisp/bin/core ./core
                  podman exec -w /usr/src $c tar -I 'zstd' -cf core.tar.zst core/lib*.so core/core
                  podman exec -w /usr/src/core $c zstd core
                  podman cp $c:/usr/src/core.tar.zst ./
                  podman cp $c:/usr/src/core/core.zst ./$#))
 (w2 ()
     (:build () #$c=$(buildah from w1)
             buildah add $c /opt/core/store/packy/dist/x86_64-musl-linux-gnu/sbcl.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c /opt/core/store/packy/dist/x86_64-musl-linux-gnu/rocksdb.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c /opt/core/store/packy/dist/x86_64-musl-linux-gnu/blake3.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c /opt/core/store/packy/dist/x86_64-musl-linux-gnu/tree-sitter.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c /opt/core/store/packy/dist/x86_64-musl-linux-gnu/tree-sitter-langs.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-sbcl-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-rocksdb-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-blake3-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-langs-pack.sh
             buildah commit $c w2$#))
 (o1 ()
     ;; buildah add $c /opt/core/store/packy/dist/x86_64-unknown-linux-gnu/emacs.tar.zst /usr/src/infra/.stash/tmp/
     ;; buildah run --workingdir /usr/src/infra/ $c sh scripts/install-emacs-pack.sh
     (:build () #$buildah build -f Containerfile.archlinux -t archlinux
             buildah build -f Containerfile.o0 -t o0
             c=$(buildah from o0)
             buildah add $c /opt/core/store/packy/src/infra.tar.zst /usr/src/
             buildah add $c /opt/core/store/packy/src/core.tar.zst /usr/src/
             buildah add $c /opt/core/store/packy/src/home/operator.tar.zst /usr/src/
             buildah run --workingdir /usr/src/home/ $c -- sh -c 'for i in `find -type f`; do cp -rpvf $i /root/; done'
             buildah add $c /opt/core/store/packy/dist/x86_64-unknown-linux-gnu/core.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/.stash/tmp $c unzstd core.zst
             buildah run --workingdir /usr/src/infra/ $c sh scripts/link-core.sh .stash/tmp/core /usr
             buildah add $c /opt/core/store/packy/dist/x86_64-unknown-linux-gnu/sbcl.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-sbcl-pack.sh
             buildah add $c /opt/core/store/packy/dist/x86_64-unknown-linux-gnu/blake3.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-blake3-pack.sh
             buildah add $c /opt/core/store/packy/dist/x86_64-unknown-linux-gnu/rocksdb.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-rocksdb-pack.sh
             buildah run --network host --workingdir /usr/src/infra/.stash/ $c curl -O https://beta.quicklisp.org/quicklisp.lisp
             buildah run --workingdir /usr/src/infra/ --network host $c sh scripts/quicklisp-install.sh
             buildah run $c sbcl --eval '(ql:quickload :cl-ppcre)' --quit
             buildah commit $c o1$#)))
