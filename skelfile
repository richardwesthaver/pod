;; src-o o w all-o all-w emacs f ~= zor:1h15m
:name "pod"
:author "Richard Westhaver"
:version "0.1.0"
:vc (:hg "https://vc.compiler.company/infra/pod")
:bind 
((prefix :env "/usr/local")
 (packy-home :env "/opt/store/packy")
 (src :env (namestring (merge-pathnames "comp" (user-homedir-pathname))))
 (packy-dist-x86 :env "/opt/store/packy/dist/x86_64-unknown-linux-gnu")
 (packy-dist-x86-musl :env "/opt/store/packy/dist/x86_64-musl-linux-gnu")
 (vc-user :env "vc")
 (vc-home :env "/home/vc")
 (vc-id :env 842)
 (operator-user :env "op")
 (operator-home :env "/home/op")
 (operator-id :env 1100))
:components
((:containerfile "w0")
 (:containerfile "o0")
 (:containerfile "f0"))
:rules
((web ()
  (:build () 
   (println "building web image")
   #$c=$(buildah from w3)
   buildah add $c $PACKY_HOME/src/home/web.tar.zst /root/
   buildah add $c $PACKY_HOME/src/org.tar.zst /home/web/org/
   buildah add $c $PACKY_HOME/doc/html/compiler.company.tar.zst /srv/http/compiler.company
   buildah run $c apk add go
   buildah config --env GOBIN=/usr/local/bin $c
   buildah run --workingdir /usr/src/infra/ $c skel build caddy
   buildah run --workingdir /usr/src/infra/ $c skel install caddy
   buildah run --workingdir /usr/src/infra/ $c skel clean
   buildah config --entrypoint '["caddy", "run", "-c", "caddy.json"]' \
   -p 2020 -p 8080 -p 8443 \
   $c
   buildah commit $c web
   buildah rm $c$#)
  (:run ()
   #$podman run --name web --replace -dt -p 8080:8080 -p 2020:2020 \
   web$#))
 (scratch ()
  (:build () #$c=$(buildah from scratch)
   buildah rm $c$#))
 (dev ()
  (:core () #$c=$(buildah from o1)
   buildah config --workingdir /usr/src/core --entrypoint '["skel", "-i"]' -p 7070 $c
   buildah commit $c core
   buildah rm $c$#)
  (:infra ()#$c=$(buildah from o1)
   buildah config --workingdir /usr/src/infra --entrypoint '["skel", "-i"]' -p 7070 $c
   buildah commit $c infra
   buildah rm $c$#)
  (:demo () #$c=$(buildah from o1)
   buildah config --workingdir /usr/src/demo --entrypoint '["skel", "-i"]' -p 7070 $c
   buildah commit $c demo
   buildah rm $c$#))
 (mail ()
  (:build () 
   (println "building mail image")
   #$c=$(buildah from o1)               
   buildah run --network=host $c pacman -Sy inetutils --noconfirm
   buildah run $c curl --proto '=https' --tlsv1.2 -sSf https://get.stalw.art/install.sh -o install.sh
   buildah run $c chmod +x ./install.sh
   buildah config --entrypoint sh --cmd ./install.sh $c
   buildah commit $c mail
   buildah rm $c$#)
  (:run () #$podman run --name mail --replace -dt -p 8080 --systemd=true mail$#))
 (emacs ()
  (:build () 
   (println "building emacs image")
   #$c=$(buildah from o1)
   buildah add $c /opt/store/packy/dist/x86_64-unknown-linux-gnu/emacs.tar.zst /usr/src/infra/.stash/tmp/
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-emacs-pack.sh
   buildah add $c /opt/store/packy/src/core.tar.zst /usr/src/
   buildah run --workingdir /usr/src/core/emacs/ $c skel install
   buildah config --workingdir /root/ --entrypoint /usr/local/bin/emacs $c
   buildah run -t $c /usr/local/bin/emacs --batch \
   -L /root/.stash/lisp/slime/ \
   -L /root/.emacs.d/lib/ \
   --eval '(setq user-custom-file "/root/.emacs.d/operator.el")' \
   --load /root/.emacs.d/init.el
   buildah commit $c emacs
   buildah rm $c$#)
  (:build-mini () #$c=$(podman run -dt o1)
   echo "building emacs-mini with output to ${PACKY_DIST_X86_MUSL}"
   podman exec -w /usr/src/infra $c skel build mini-emacs
   podman exec -w /usr/src/infra $c skel dist mini-emacs
   podman cp $c:/usr/src/infra/.stash/emacs-mini.tar.zst $PACKY_DIST_X86/$#)
  (:build-org () #$c=$(podman run -dt emacs --cmd sh)
   podman cp $SRC/ $c:/root/
   podman exec -t -w /root $c /usr/local/bin/emacs --batch \
   --eval '(package-initialize)' \
   --eval '(setq inferior-lisp-program "sbcl")' \
   --eval '(setq publish-dir "/tmp/compiler.company")' \
   --eval '(setq project-dir "/root/org")' \
   --eval '(setq company-source-directory "/root/")' \
   --load /root/.emacs.d/init.el \
   --eval '(load-library "publish")' \
   --eval '(org-babel-lob-ingest "/root/org/meta/babel.org")' \
   --eval '(publish t t)'
   podman exec -w /tmp $c tar -I 'zstd' -cf compiler.company.tar.zst compiler.company
   podman cp $c:/tmp/compiler.company.tar.zst $PACKY_HOME/doc/html/compiler.company.tar.zst
   podman stop $c$#)
  (:run () #$podman run --name emacs --replace -dt --systemd=true emacs$#))
 (vc ()
  (:build () (println "building vc image")
   #$c=$(buildah from w0)
   buildah run $c apk add py3-pygments py3-pygit2 py3-dulwich py3-pip apache2-utils uwsgi
   buildah run --user root $c addgroup $VC_USER
   buildah run --user root $c adduser -G vc -S -s /usr/bin/bash -u $VC_ID $VC_USER
   buildah config --user $VC_USER --workingdir $VC_HOME --entrypoint "./serve.sh" -p 8888 $c
   buildah run $c pip install --user --break-system-packages hg-evolve
   buildah run $c mkdir $VC_HOME/.stash $VC_HOME/src
   buildah add --chown vc:vc $c $PACKY_HOME/src/home/vc.tar.zst /home/vc/.stash/
   buildah run --workingdir /home/vc/.stash $c cp -rf home/. $VC_HOME/
   buildah run --user root --workingdir /home/vc/ $c chown -R vc:vc .
   buildah commit $c vc
   buildah rm $c$#)
  (:run () #$podman run --name vc --replace -dt -v /home/ellis/comp/:/home/vc/src -p 8888:8888 vc$#))
 ;; (git ()
 ;;  (:build () #$podman build -f Containerfile.git -t git --no-cache$#)
 ;;  (:run () #$podman run --name git --replace -dt -v $HOME/src/packy:/home/vc/packy:z -p 8889:80 git$#))
 ;;; workers
 (worker ()
  #$c=$(buildah from scratch)
  buildah add $c /usr/bin/core /root/
  buildah config --workingdir /root --entrypoint "./core" $c
  buildah commit $c worker
  buildah rm $c$#)
 (w ()
  (:build (build-w1 build-w2 build-w3))
  (:build-all (build-sbcl-w1 build-rocksdb-w1 
               build-blake3-w1 build-tree-sitter-w1 
               build-zstd-w1 build-ublksrv-w1 build-bzip2-w1 build-liburing-w1
               build-tree-sitter-langs-w1 build-core-w2
               build-emacs-mini-w3)))
 (w1 ()
  (:build () (println "building w1 image")
   #$podman build -f Containerfile.w0 -t w0
   c=$(buildah from w0)
   buildah add $c $PACKY_HOME/src/sbcl.tar.zst /usr/src/
   buildah add $c $PACKY_HOME/src/core.tar.zst /usr/src/
   buildah add $c $PACKY_HOME/src/infra.tar.zst /usr/src/
   buildah add $c $PACKY_HOME/src/home/operator.tar.zst /usr/src/
   buildah run $c mkdir -pv /usr/share/lisp /root/.stash/lisp
   buildah run --workingdir /usr/src $c cp -rf home/. /root/
   buildah run $c apk add sbcl liburing-dev libxkbcommon-dev btrfs-progs-dev libevdev-dev readline-dev perl gcompat
   buildah run --workingdir /usr/src/sbcl $c -- sh make.sh
   buildah run --workingdir /usr/src/sbcl $c -- sh install.sh
   buildah run $c apk del sbcl
   buildah run $c mkdir -pv /usr/src/infra/.stash/src /usr/src/infra/.stash/tmp
   buildah run --network host --workingdir /usr/src/infra/.stash/ $c curl -O https://beta.quicklisp.org/quicklisp.lisp
   buildah run --workingdir /usr/src/infra/ --network host $c sh scripts/quicklisp-install.sh
   buildah run $c sbcl --eval '(ql:quickload (list :cl-ppcre :ironclad))' --quit
   buildah config --env PATH="/usr/local/bin:/usr/bin:/bin:/root/.cargo/bin:/root/go/bin:/root/.local/bin:/usr/local/sbin" --cmd /bin/bash $c
   buildah commit $c w1
   buildah rm $c$#)
  (:build-sbcl () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/sbcl $c sh make-shared-library.sh
   # mark-region-gc doesn't work here
   podman exec -w /usr/src/sbcl $c sh make.sh --dynamic-space-size=8Gb --fancy
   podman exec -w /usr/src/sbcl $c mv /usr/src/sbcl /usr/src/infra/.stash/src/
   podman exec -w /usr/src/infra $c ./scripts/dist-sbcl-binary.sh
   podman cp $c:/usr/src/infra/.stash/sbcl.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-rocksdb () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c git clone https://github.com/facebook/rocksdb .stash/src/rocksdb
   podman exec -w /usr/src/infra/.stash/src/rocksdb $c make shared_lib DISABLE_JEMALLOC=1
   podman exec -w /usr/src/infra $c sh scripts/dist-rocksdb-binary.sh
   podman cp $c:/usr/src/infra/.stash/rocksdb.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-blake3 () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c git clone https://github.com/BLAKE3-team/BLAKE3 .stash/src/blake3
   podman exec -w /usr/src/infra/.stash/src/blake3/c $c cc -shared -O3 -o libblake3.so blake3.c blake3_dispatch.c blake3_portable.c \
   blake3_sse2_x86-64_unix.S blake3_sse41_x86-64_unix.S blake3_avx2_x86-64_unix.S blake3_avx512_x86-64_unix.S
   
   podman exec -w /usr/src/infra $c sh scripts/dist-blake3.sh
   podman cp $c:/usr/src/infra/.stash/blake3.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-zstd () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c git clone https://github.com/facebook/zstd .stash/src/zstd
   podman exec -w /usr/src/infra/.stash/src/zstd/lib $c make
   podman exec -w /usr/src/infra $c sh scripts/dist-zstd.sh
   podman cp $c:/usr/src/infra/.stash/zstd.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-liburing () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c git clone https://github.com/axboe/liburing .stash/src/liburing
   podman exec -w /usr/src/infra/.stash/src/liburing $c sh ./configure --cc=gcc --cxx=g++
   podman exec -w /usr/src/infra/.stash/src/liburing $c make
   podman exec -w /usr/src/infra/.stash/src/liburing $c make liburing.pc
   podman exec -w /usr/src/infra $c sh scripts/dist-liburing.sh
   podman cp $c:/usr/src/infra/.stash/liburing.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-bzip2 () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c git clone https://gitlab.com/federicomenaquintero/bzip2 .stash/src/bzip2
   podman exec -w /usr/src/infra/.stash/src/bzip2 $c meson --prefix /usr/local build
   podman exec -w /usr/src/infra/.stash/src/bzip2 $c ninja -C build
   podman exec -w /usr/src/infra $c sh scripts/dist-bzip2.sh
   podman cp $c:/usr/src/infra/.stash/bzip2.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-ublksrv () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c git clone https://github.com/ublk-org/ublksrv .stash/src/ublksrv
   podman exec -w /usr/src/infra/.stash/src/ublksrv $c autoreconf -i
   podman exec -w /usr/src/infra/.stash/src/ublksrv $c sh ./configure
   podman exec -w /usr/src/infra/.stash/src/ublksrv $c make
   podman exec -w /usr/src/infra $c sh scripts/dist-ublksrv.sh
   podman cp $c:/usr/src/infra/.stash/ublksrv.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-tree-sitter () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c git clone https://github.com/tree-sitter/tree-sitter .stash/src/tree-sitter
   podman exec -w /usr/src/infra/.stash/src/tree-sitter $c make libtree-sitter.so
   podman exec -w /usr/src/infra $c sh scripts/dist-tree-sitter.sh
   podman cp $c:/usr/src/infra/.stash/tree-sitter.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#)
  (:build-tree-sitter-langs () #$c=$(podman run -dt w1)
   podman exec -w /usr/src/infra $c sh scripts/dist-tree-sitter-langs.sh
   podman cp $c:/usr/src/infra/.stash/tree-sitter-langs.tar.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#))
 (w2 ()
  (:build () (println "building w2 image")
   #$c=$(buildah from w1)
   buildah add $c $PACKY_DIST_X86_MUSL/sbcl.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/rocksdb.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/blake3.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/zstd.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/liburing.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/bzip2.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/ublksrv.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/tree-sitter.tar.zst /usr/src/infra/.stash/tmp/
   buildah add $c $PACKY_DIST_X86_MUSL/tree-sitter-langs.tar.zst /usr/src/infra/.stash/tmp/
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-sbcl-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-rocksdb-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-blake3-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-zstd-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-bzip2-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-liburing-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-ublksrv-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-pack.sh
   buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-langs-pack.sh
   buildah commit $c w2
   buildah rm $c$#)
  (:build-core () #$c=$(podman run -dt w2)
   podman exec -w /usr/src/core/ffi/tree-sitter $c cc \
   -g -O2 -Wall -Wno-unused-value -ltree-sitter -shared \
   alien.c -o ../../libtree-sitter-alien.so
   podman exec -w /usr/src/core/ffi/zstd $c cc \
   -g -O2 -Wall -Wno-unused-value -lzstd -shared \
   alien.c -o ../../libzstd-alien.so
   podman exec -w /usr/src/core $c cp libtree-sitter-alien.so libzstd-alien.so /usr/local/lib/
   podman exec -w /root/.stash/lisp/ $c \
   git clone https://github.com/slime/slime slime
   podman exec -w /usr/src/core $c sbcl \
   --eval '(ql:quickload (list :ironclad :core :swank-client :swank-crew))' \
   --eval '(asdf:make :bin/core)' --quit
   podman exec -w /usr/src/core $c mv bin/core ./core
   podman exec -w /usr/src $c tar -I 'zstd' -cf core.tar.zst core/libtree-sitter-alien.so core/libzstd-alien.so core/core
   podman exec -w /usr/src/core $c zstd core
   podman cp $c:/usr/src/core.tar.zst $PACKY_DIST_X86_MUSL/
   podman cp $c:/usr/src/core/core.zst $PACKY_DIST_X86_MUSL/
   podman stop $c$#))
 (w3 () 
  (:build () (println "building w3 image")
   #$c=$(buildah from w2)
   buildah add $c $PACKY_DIST_X86_MUSL/core.tar.zst /usr/src/infra/.stash/tmp/
   buildah run --workingdir /usr/src/infra -e PREFIX=$PREFIX $c sh scripts/install-core-pack.sh
   # load again to install quicklisp dependencies
   buildah run --workingdir /usr/src/core $c sbcl --eval '(ql:quickload :core)' --quit
   buildah run --workingdir /usr/src/core $c skel clean
   buildah run --workingdir /usr/src/infra $c skel install rustup 
   buildah run $c sh source "$HOME/.cargo/env"
   buildah run --workingdir /usr/src/infra $c skel install cargo-tools
   buildah run --workingdir /usr/src/infra $c skel clean
   buildah commit $c w3
   buildah rm $c$#)
  (:build-emacs-mini () #$c=$(podman run -dt w3)
   echo "building emacs-mini with output to ${PACKY_DIST_X86_MUSL}"
   podman exec -w /usr/src/infra $c skel build mini-emacs
   podman exec -w /usr/src/infra $c skel dist mini-emacs
   podman cp $c:/usr/src/infra/.stash/emacs-mini.tar.zst $PACKY_DIST_X86_MUSL/$#))
 ;;; operator
