 (o ()
  (:build (build-o1))
  (:build-all () #$c=$(podman run -dt o1)
   echo "building all binary packs with output to ${PACKY_DIST_X86}"
   podman exec -w /usr/src/infra $c skel build sbcl rocksdb blake3 tree-sitter langs-tree-sitter emacs zstd bzip2 liburing ublksrv
   podman exec -w /usr/src/infra $c skel dist rocksdb sbcl blake3 tree-sitter langs-tree-sitter emacs zstd bzip2 liburing ublksrv
   podman exec -w /usr/src/core $c skel build c
   podman exec -w /usr/src/core $c skel install c
   podman exec -w /usr/src/core $c skel make
   podman exec -w /usr/src/core $c skel make dist
   podman cp $c:/usr/src/core/.stash/core.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/emacs.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/rocksdb.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/sbcl.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/blake3.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/zstd.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/ublksrv.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/bzip2.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/liburing.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/tree-sitter.tar.zst $PACKY_DIST_X86/
   podman cp $c:/usr/src/infra/.stash/tree-sitter-langs.tar.zst $PACKY_DIST_X86/
   podman stop $c$#)
  (:build-src () #$c=$(podman run -dt o1)
   echo "building all source packs with output to ${PACKY_HOME}/src"
