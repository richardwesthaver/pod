;;; pod @ 2024-06-21.02:30:12 -*- mode:skel; -*-
:name "pod"
:author "Richard Westhaver"
:version "0.1.0"
:vc (:hg "https://vc.compiler.company/comp/pod")
:bind ((prefix :env "/usr/local")
       (packy-home :env "/opt/core/store/packy")
       (src :env (namestring (merge-pathnames "comp" (user-homedir-pathname))))
       (packy-dist-x86 :env "/opt/core/store/packy/dist/x86_64-unknown-linux-gnu")
       (packy-dist-x86-musl :env "/opt/core/store/packy/dist/x86_64-musl-linux-gnu"))
:components
((:containerfile "scratch")
 (:containerfile "alpine")
 (:containerfile "archlinux")
 (:containerfile "dev")
 (:containerfile "w0")
 (:containerfile "o0")
 (:containerfile "web")
 (:containerfile "vc")
 (:containerfile "ubuntu")
 (:containerfile "amazon")
 (:containerfile "archriscv"))
:rules
((web ()
      (:build () 
              (println "building web image")
              #$buildah build -f Containerfile.web -t web --no-cache
              c=$(buildah from web)
              buildah add $c $PACKY_HOME/src/home/web.tar.zst /home/web/
              buildah add $c $PACKY_HOME/src/org.tar.zst /home/web/org/
              buildah commit $c web
              buildah rm $c$#)
      (:run ()
            #$podman run --name web --replace -dt -p 8080:8080 -p 2020:2020 \
            --volume /srv/http:/home/web/www \
            web$#))
 (mail ()
       (:build () 
               (println "building mail image")
               #$c=$(buildah from o1)               
               buildah run --network=host $c pacman -Sy inetutils --noconfirm
               buildah run $c curl --proto '=https' --tlsv1.2 -sSf https://get.stalw.art/install.sh -o install.sh
               buildah run $c chmod +x ./install.sh
               buildah config --entrypoint sh --cmd ./install.sh $c
               buildah commit $c mail
               buildah rm $c$#)
       (:run () #$podman run --name mail --replace -dt -p 8080 --systemd=true mail$#))
 (emacs ()
       (:build () 
               (println "building emacs image")
               #$c=$(buildah from o1)
               buildah add $c /opt/core/store/packy/dist/x86_64-unknown-linux-gnu/emacs.tar.zst /usr/src/infra/.stash/tmp/
               buildah run --workingdir /usr/src/infra/ $c sh scripts/install-emacs-pack.sh
               buildah run --workingdir /usr/src/core/emacs/ $c skel install
               buildah run -t $c /usr/local/bin/emacs --batch --load /root/.emacs.d/init.el --load /root/.emacs.d/operator.el
               buildah config --workingdir /root/ --entrypoint '["/usr/local/bin/emacs", "--load", "/root/.emacs.d/operator.el"]' $c
               buildah commit $c emacs
               buildah rm $c$#)
       (:build-org () #$c=$(podman run -dt emacs --cmd sh)
                   podman cp $SRC/org $c:/root/org
                   podman exec $c mkdir /tmp/org
                   podman exec -w /root $c /usr/local/bin/emacs --batch \
                   --eval '(package-initialize)' \
                   --load /root/.emacs.d/init.el \
                   --eval '(setq project-dir "/root/org")' \
                   --eval '(setq publish-dir "/tmp/org")' \
                   --eval '(load-library "publish")' \
                   --eval '(org-babel-lob-ingest "/root/org/meta/babel.org")' \
                   --eval '(slime)'
                   --eval '(publish)'
                   podman cp $c:/tmp/org org
                   podman stop $c$#)
       (:run () #$podman run --name emacs --replace -dt --systemd=true emacs$#))

 (vc ()
     (:build () (println "building vc image")
             #$buildah build -f Containerfile.vc -t vc
             c=$(buildah from vc)
             buildah run $c mkdir .stash src
             buildah add --chown vc:vc $c $PACKY_HOME/src/home/vc.tar.zst /home/vc/.stash/
             buildah run --workingdir /home/vc/.stash $c cp -rf home/. /home/vc/
             buildah run --user root --workingdir /home/vc/ $c chown -R vc:vc .
             buildah run --workingdir /home/vc/.stash $c rm -rf ./home
             buildah commit $c vc
             buildah rm $c$#)
     (:run () #$podman run --name vc --replace -dt -v /home/vc/src:/home/vc/src:z -p 8888:8888 vc$#))
 ;; (git ()
 ;;  (:build () #$podman build -f Containerfile.git -t git --no-cache$#)
 ;;  (:run () #$podman run --name git --replace -dt -v $HOME/src/packy:/home/vc/packy:z -p 8889:80 git$#))
 (dev ()
      (:build () #$podman build -f Containerfile.dev -t dev --no-cache$#)
      (:run () #$podman run --name dev --replace -dt dev$#))
 (archlinux ()
            (:build () #$podman build -f Containerfile.archlinux -t archlinux --no-cache$#)
            (:run () #$podman run --name archlinux --replace -dt archlinux$#))
 (alpine ()
         (:build () #$podman build -f Containerfile.alpine -t alpine --no-cache$#))
 (amazon ()
         (:build () #$podman build -f Containerfile.amazon -t amazon$#))
 ;;; workers
 (w ()
    (:build (build-w1 build-w2 build-w3))
    (:build-all (build-sbcl-w1 build-rocksdb-w1 
                               build-blake3-w1 build-tree-sitter-w1 
                               build-tree-sitter-langs-w1 build-core-w2
                               build-emacs-mini-w3)))
 (w1 ()
     (:build () (println "building w1 image")
             #$buildah build -f Containerfile.alpine -t alpine
             buildah build -f Containerfile.w0 -t w0
             c=$(buildah from w0)
             buildah add $c $PACKY_HOME/src/sbcl.tar.zst /usr/src/
             buildah add $c $PACKY_HOME/src/core.tar.zst /usr/src/
             buildah add $c $PACKY_HOME/src/infra.tar.zst /usr/src/
             buildah add $c $PACKY_HOME/src/home/operator.tar.zst /usr/src/
             buildah run $c mkdir -pv /usr/share/lisp /root/.stash/lisp
             buildah run --workingdir /usr/src $c cp -rf home/. /root/
             buildah run $c apk add sbcl liburing-dev libxkbcommon-dev btrfs-progs-dev libevdev-dev readline-dev perl gcompat
             buildah run --workingdir /usr/src/sbcl $c -- sh make.sh
             buildah run --workingdir /usr/src/sbcl $c -- sh install.sh
             buildah run $c apk del sbcl
             buildah run $c mkdir -pv /usr/src/infra/.stash/src /usr/src/infra/.stash/tmp
             buildah run --network host --workingdir /usr/src/infra/.stash/ $c curl -O https://beta.quicklisp.org/quicklisp.lisp
             buildah run --workingdir /usr/src/infra/ --network host $c sh scripts/quicklisp-install.sh
             buildah run $c sbcl --eval '(ql:quickload (list :cl-ppcre :ironclad))' --quit
             buildah commit $c w1
             buildah rm $c$#)
     (:build-sbcl () #$c=$(podman run -dt w1)
                  podman exec -w /usr/src/sbcl $c sh make-shared-library.sh
                  # mark-region-gc doesn't work here
                  podman exec -w /usr/src/sbcl $c sh make.sh --dynamic-space-size=8Gb --fancy
                  podman exec -w /usr/src/sbcl $c mv /usr/src/sbcl /usr/src/infra/.stash/src/
                  podman exec -w /usr/src/infra $c ./scripts/dist-sbcl-binary.sh
                  podman cp $c:/usr/src/infra/.stash/sbcl.tar.zst $PACKY_DIST_X86_MUSL/
                  podman stop $c$#)
     (:build-rocksdb () #$c=$(podman run -dt w1)
                     podman exec -w /usr/src/infra $c sh scripts/get-rocksdb.sh
                     podman exec -w /usr/src/infra/.stash/src/rocksdb $c make shared_lib DISABLE_JEMALLOC=1
                     podman exec -w /usr/src/infra $c sh scripts/dist-rocksdb-binary.sh
                     podman cp $c:/usr/src/infra/.stash/rocksdb.tar.zst $PACKY_DIST_X86_MUSL/
                     podman stop $c$#)
     (:build-blake3 () #$c=$(podman run -dt w1)
                    podman exec -w /usr/src/infra $c sh scripts/get-blake3.sh
                    podman exec -w /usr/src/infra/.stash/src/blake3/c $c cc -shared -O3 -o libblake3.so blake3.c blake3_dispatch.c blake3_portable.c \
                    blake3_sse2_x86-64_unix.S blake3_sse41_x86-64_unix.S blake3_avx2_x86-64_unix.S blake3_avx512_x86-64_unix.S
                    
                    podman exec -w /usr/src/infra $c sh scripts/dist-blake3.sh
                    podman cp $c:/usr/src/infra/.stash/blake3.tar.zst $PACKY_DIST_X86_MUSL/
                    podman stop $c$#)
     (:build-tree-sitter () #$c=$(podman run -dt w1)
                         podman exec -w /usr/src/infra $c sh scripts/get-tree-sitter.sh
                         podman exec -w /usr/src/infra/.stash/src/tree-sitter $c make libtree-sitter.so
                         podman exec -w /usr/src/infra $c sh scripts/dist-tree-sitter.sh
                         podman cp $c:/usr/src/infra/.stash/tree-sitter.tar.zst $PACKY_DIST_X86_MUSL/
                         podman stop $c$#)
     (:build-tree-sitter-langs () #$c=$(podman run -dt w1)
                               podman exec -w /usr/src/infra $c sh scripts/dist-tree-sitter-langs.sh
                               podman cp $c:/usr/src/infra/.stash/tree-sitter-langs.tar.zst $PACKY_DIST_X86_MUSL/
                               podman stop $c$#))
 (w2 ()
     (:build () (println "building w2 image")
             #$c=$(buildah from w1)
             buildah run $c apk add libssh2-dev
             buildah add $c $PACKY_DIST_X86_MUSL/sbcl.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c $PACKY_DIST_X86_MUSL/rocksdb.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c $PACKY_DIST_X86_MUSL/blake3.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c $PACKY_DIST_X86_MUSL/tree-sitter.tar.zst /usr/src/infra/.stash/tmp/
             buildah add $c $PACKY_DIST_X86_MUSL/tree-sitter-langs.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-sbcl-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-rocksdb-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-blake3-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-pack.sh
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-langs-pack.sh
             buildah commit $c w2
             buildah rm $c$#)
     (:build-core () #$c=$(podman run -dt w2)
                  podman exec -w /usr/src/core/ffi/tree-sitter $c cc \
                  -g -O2 -Wall -Wno-unused-value -ltree-sitter -shared \
                  alien.c -o ../../libtree-sitter-alien.so
                  podman exec -w /usr/src/core/ffi/zstd $c cc \
                  -g -O2 -Wall -Wno-unused-value -lzstd -shared \
                  alien.c -o ../../libzstd-alien.so
                  podman exec -w /usr/src/core $c cp libtree-sitter-alien.so libzstd-alien.so /usr/local/lib/
                  buildah run --workingdir /root/.stash/lisp/ $c \
                  git clone https://github.com/slime/slime
                  podman exec -w /usr/src/core $c sbcl \
                  --eval '(ql:quickload (list :ironclad :core :swank-client :swank-crew))' \
                  --eval '(asdf:make :bin/core)' --quit
                  podman exec -w /usr/src/core $c mv bin/core ./core
                  podman exec -w /usr/src $c tar -I 'zstd' -cf core.tar.zst core/libtree-sitter-alien.so core/libzstd-alien.so core/core
                  podman exec -w /usr/src/core $c zstd core
                  podman cp $c:/usr/src/core.tar.zst $PACKY_DIST_X86_MUSL/
                  podman cp $c:/usr/src/core/core.zst $PACKY_DIST_X86_MUSL/
                  podman stop $c$#))
 (w3 () 
     (:build () (println "building w3 image")
             #$c=$(buildah from w2)
             buildah add $c $PACKY_DIST_X86_MUSL/core.tar.zst /usr/src/infra/.stash/tmp/
             buildah run $c apk add autoconf libgccjit-dev texinfo
             buildah run --workingdir /usr/src/infra -e PREFIX=$PREFIX $c sh scripts/install-core-pack.sh
             # load again to install quicklisp dependencies
             buildah run --workingdir /usr/src/core $c sbcl --eval '(ql:quickload :core)' --quit
             buildah run --workingdir /usr/src/core $c skel clean
             buildah run --workingdir /usr/src/infra $c skel install rustup cargo-tools
             buildah run --workingdir /usr/src/infra $c skel clean
             buildah commit $c w3
             buildah rm $c$#)
     (:build-emacs-mini () #$c=$(podman run -dt w3)
                        echo "building emacs-mini with output to ${PACKY_DIST_X86_MUSL}"
                        podman exec -w /usr/src/infra $c sh scripts/get-emacs.sh
                        podman exec -w /usr/src/infra $c skel build mini-emacs
                        podman exec -w /usr/src/infra $c skel dist mini-emacs
                        podman cp $c:/usr/src/infra/.stash/emacs-mini.tar.zst $PACKY_DIST_X86_MUSL/$#))
 ;;; operator
 (o1 ()
     (:build () (println "building o1 image")
             #$buildah build -f Containerfile.archlinux -t archlinux
             buildah build -f Containerfile.o0 -t o0
             c=$(buildah from o0)
             buildah add $c $PACKY_HOME/src/infra.tar.zst /usr/src/
             buildah add $c $PACKY_HOME/src/core.tar.zst /usr/src/
             buildah add $c $PACKY_HOME/src/home/operator.tar.zst /usr/src/
             buildah run --workingdir /usr/src $c cp -rf home/. /root/
             buildah run --workingdir /root/.stash/lisp/ $c \
             git clone https://github.com/slime/slime
             buildah add $c $PACKY_DIST_X86/sbcl.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-sbcl-pack.sh
             buildah add $c $PACKY_DIST_X86/tree-sitter.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-pack.sh
             buildah add $c $PACKY_DIST_X86/tree-sitter-langs.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-tree-sitter-langs-pack.sh
             buildah add $c $PACKY_DIST_X86/blake3.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-blake3-pack.sh
             buildah add $c $PACKY_DIST_X86/rocksdb.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra/ $c sh scripts/install-rocksdb-pack.sh
             buildah run --network host --workingdir /usr/src/infra/.stash/ $c curl -O https://beta.quicklisp.org/quicklisp.lisp
             buildah run --workingdir /usr/src/infra/ --network host $c sh scripts/quicklisp-install.sh
             podman exec -w /usr/src/infra $c skel install rustup
             buildah add $c $PACKY_DIST_X86/core.tar.zst /usr/src/infra/.stash/tmp/
             buildah run --workingdir /usr/src/infra -e PREFIX=$PREFIX $c scripts/install-core-pack.sh

             buildah run --workingdir /usr/src/core $c sbcl --eval '(ql:quickload (list :cl-ppcre :ironclad :swank-client :swank-crew :core))' --quit
             buildah commit $c o1
             buildah rm $c$#))
 (o ()
    (:build (build-o1))
    (:build-all () #$c=$(podman run -dt o1)
                echo "building all binary packs with output to ${PACKY_DIST_X86}"
                podman exec -w /usr/src/infra $c skel build sbcl rocksdb emacs tree-sitter blake3
                podman exec -w /usr/src/infra $c skel dist rocksdb sbcl blake3 tree-sitter langs-tree-sitter emacs
                podman exec -w /usr/src/core $c skel make
                podman exec -w /usr/src/core $c skel dist
                podman cp $c:/usr/src/core/.stash/core.tar.zst $PACKY_DIST_X86/
                podman cp $c:/usr/src/infra/.stash/emacs.tar.zst $PACKY_DIST_X86/
                podman cp $c:/usr/src/infra/.stash/rocksdb.tar.zst $PACKY_DIST_X86/
                podman cp $c:/usr/src/infra/.stash/sbcl.tar.zst $PACKY_DIST_X86/
                podman cp $c:/usr/src/infra/.stash/blake3.tar.zst $PACKY_DIST_X86/
                podman cp $c:/usr/src/infra/.stash/tree-sitter.tar.zst $PACKY_DIST_X86/
                podman cp $c:/usr/src/infra/.stash/tree-sitter-langs.tar.zst $PACKY_DIST_X86/
                podman stop $c$#)
    (:build-src () #$c=$(podman run -dt o1)
                echo "building all source packs with output to ${PACKY_HOME}/src"
                podman cp --overwrite $SRC/infra/. $c:/usr/src/infra
                podman cp --overwrite $SRC/core/. $c:/usr/src/core
                podman cp --overwrite $SRC/demo/. $c:/usr/src/demo
                podman cp --overwrite $SRC/org/. $c:/usr/src/org
                podman exec -w /usr/src/infra $c skel install rustup
                podman exec -w /usr/src/infra $c skel dist all-source
                podman cp $c:/usr/src/infra/infra.tar.zst $PACKY_HOME/src/
                podman cp $c:/usr/src/infra/core.tar.zst $PACKY_HOME/src/
                podman cp $c:/usr/src/infra/demo.tar.zst $PACKY_HOME/src/
                podman cp $c:/usr/src/infra/home.tar.zst $PACKY_HOME/src/
                podman cp $c:/usr/src/infra/org.tar.zst $PACKY_HOME/src/
                podman stop $c$#)))
