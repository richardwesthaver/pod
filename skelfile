;; src-o o w all-o all-w emacs f ~= zor:1h15m
:name "pod"
:author "Richard Westhaver"
:version "0.1.0"
:vc (:hg "https://vc.compiler.company/infra/pod")
:bind 
((prefix :env "/usr")
 (packy-home :env "/opt/store/packy")
 (src :env (namestring (merge-pathnames "comp" (user-homedir-pathname))))
 (packy-dist-x86 :env "/opt/store/packy/dist/x86_64-unknown-linux-gnu")
 (vc-user :env "vc")
 (vc-home :env "/home/vc")
 (vc-id :env 842)
 (operator-user :env "op")
 (operator-home :env "/home/op")
 (operator-id :env 1100))
:components
((:containerfile "o0"))
:rules
((web ()
  (:build () 
   (info! "building web image")
   (with-buildah (c "o1" :commit "web")
    (buildah-add (merge-env-pathnames "src/home/web.tar.zst" "PACKY_HOME") "/usr/src/")
    (buildah-add (merge-env-pathnames "src/org.tar.zst" "PACKY_HOME") "/usr/src/")
    (buildah-add (merge-env-pathnames "doc/html/compiler.company.tar.zst" "PACKY_HOME") "/srv/http/")
    (buildah-run "pacman -Sy go caddy --noconfirm")
    ;; (buildah-config "--env" "GOBIN=/usr/bin")
    ;; (buildah-run '("skel" "make" "build-caddy") :dir "/usr/src/infra/")
    ;; (buildah-run '("skel" "make" "install-caddy") :dir "/usr/src/infra/")
    ;; (buildah-run '("skel" "clean") :dir "/usr/src/infra/")
    (buildah-config 
     "--entrypoint" "[\"caddy\", \"run\", \"-c\", \"/usr/src/home/caddy.json\"]")))
  (:run ()
   (pod:podman-run :name "web" :replace t :detach t :tty t :ports '(8080 2020) :container "web")))
 (dev ()
  (:core () #$c=$(buildah from o1)
   buildah config --workingdir /usr/src/core --cmd '["skel", "shell"]' -p 7070 $c
   buildah commit $c core
   buildah rm $c$#)
  (:infra ()#$c=$(buildah from o1)
   buildah config --workingdir /usr/src/infra --cmd '["skel", "shell"]' -p 7070 $c
   buildah commit $c infra
   buildah rm $c$#)
  (:demo () #$c=$(buildah from o1)
   buildah config --workingdir /usr/src/demo --cmd '["skel", "shell"]' -p 7070 $c
   buildah commit $c demo
   buildah rm $c$#))
 (mail ()
  (:build () 
   (info! "building mail image")
   #$c=$(buildah from o1)               
   buildah run $c pacman -Sy inetutils --noconfirm
   buildah run $c curl --proto '=https' --tlsv1.2 -sSf https://get.stalw.art/install.sh -o install.sh
   buildah run $c chmod +x ./install.sh
   buildah config --entrypoint sh --cmd ./install.sh $c
   buildah commit $c mail
   buildah rm $c$#)
  (:run () 
   (podman-run :name "mail" :container "mail" 
    :replace t :detach t :tty t :systemd true))) ;; -p 8080
 (emacs ()
  (:build () 
   (info! "building emacs image")
   (with-buildah (c "o3" :commit "emacs")
    (buildah-run "pacman -Sy offlineimap notmuch sqlite --noconfirm")
    (buildah-add "/opt/store/packy/dist/x86_64-unknown-linux-gnu/emacs.tar.zst" "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-emacs-pack.sh") :dir "/usr/src/infra/")
    (buildah-add "/opt/store/packy/src/core.tar.zst" "/usr/src/")
    (buildah-run "skel install" :dir "/usr/src/core/emacs/")
    (buildah-config "--workingdir" "/root/" "--entrypoint" "/usr/bin/emacs")
    (buildah-run '("/usr/bin/emacs" "--batch" 
                   "-L" "/root/.stash/lisp/slime/"
                   "-L" "/root/.emacs.d/lib/"
                   "--eval" "'(setq user-custom-file \"/root/.emacs.d/operator.el\")'"
                   "--load /root/.emacs.d/init.el"))))
  (:build-mini () 
   (with-container (c "o1" :detach t :tty t :run "bash")
    (info! "building emacs-mini with output to ~A" (sb-posix:getenv "PACKY_DIST_X86"))
    (podman-exec "skel build mini-emacs" :dir "/usr/src/infra")
    (podman-exec "skel dist mini-emacs" :dir "/usr/src/infra")
    (podman-cp "$c:/usr/src/infra/.stash/emacs-mini.tar.zst" "$PACKY_DIST_X86/")))
  (:build-org () 
   (with-container (c "emacs" :detach t :tty t :cmd "sh" :stop t :run "bash")
    (podman-cp "$SRC/" "$c:/root/")
    (podman-exec 
     '("/usr/bin/emacs" "--batch"
       "--eval" "'(package-initialize)'"
       "--eval" "'(setq inferior-lisp-program \"core\")'"
       "--eval" "'(setq publish-dir \"/tmp/compiler.company\")'"
       "--eval" "'(setq project-dir \"/root/org\")'"
       "--eval" "'(setq company-source-directory \"/root/\")'"
       "--load" "/root/.emacs.d/init.el"
       "--eval" "'(load-library \"publish\")'"
       "--eval" "'(org-babel-lob-ingest \"/root/org/meta/babel.org\")'"
       "--eval" "'(publish t t)")
     :dir "/root")
    (podman-exec "tar -I 'zstd' -cf compiler.company.tar.zst compiler.company" :dir "/tmp")
    (podman-cp "$c:/tmp/compiler.company.tar.zst" 
     (merge-env-pathnames "doc/html/compiler.company.tar.zst" "PACKY_HOME"))))
  (:run () (pod:podman-run :name "emacs" :container "emacs" :replace t :detach t :tty t :systemd t)))
 (vc ()
  (:build () (println "building vc image")
   #$c=$(buildah from o0)
   buildah run $c pacman -Sy python-pygments python-pygit2 python-dulwich python-pip uwsgi --noconfirm
   buildah run --user root $c useradd -s /usr/bin/bash -u $VC_ID $VC_USER
   buildah config --user $VC_USER --workingdir $VC_HOME --entrypoint "./serve.sh" -p 8888 $c
   buildah run $c pip install --user --break-system-packages hg-evolve
   buildah run $c mkdir $VC_HOME/.stash $VC_HOME/src
   buildah add --chown vc $c $PACKY_HOME/src/home/vc.tar.zst /usr/src/
   buildah run $c cp -rf /usr/src/home/. $VC_HOME/
   buildah run --user root --workingdir /home/vc/ $c chown -R vc .
   buildah commit $c vc
   buildah rm $c$#)
  (:run () #$podman run --name vc --replace -dt -v /home/ellis/comp/:/home/vc/src -p 8888:8888 vc$#))
 ;; (git ()
 ;;  (:build () #$podman build -f Containerfile.git -t git --no-cache$#)
 ;;  (:run () #$podman run --name git --replace -dt -v $HOME/src/packy:/home/vc/packy:z -p 8889:80 git$#))
 ;;; workers
 (worker ()
  (with-buildah (c "o3" :commit "worker")
   (buildah-add "/usr/bin/core" "/usr/bin/")
   (buildah-config "--workingdir" "/" "--cmd" "/usr/bin/core")))
 ;;; operator
 (o0 () (:build () (podman-build :file "Containerfile.o0" :tag "o0")))
 (o1 ()
  (:build (build-o0) (println "building o1 image")
   (with-buildah (c "o0" :commit "o1")
    (buildah-add (merge-env-pathnames "src/infra.tar.zst" "PACKY_HOME") "/usr/src/")
    (buildah-add (merge-env-pathnames "src/home/operator.tar.zst" "PACKY_HOME") "/usr/src/")
    (buildah-run '("cp" "-rf" "home/." "/root/") :dir "/usr/src")
    (buildah-run '("git" "clone" "https://github.com/richardwesthaver/slime") :dir "/usr/share/lisp/")
    (buildah-copy 
     (namestring (merge-env-pathnames "core.zst" "PACKY_DIST_X86"))
     "/usr/src/infra/.stash/cache/tmp/core.zst")
    (buildah-run '("chown" "-R" "root:root" ".") :dir "/usr/src/")
    (buildah-run '("scripts/install-core-pack.sh")
     :dir "/usr/src/infra" 
     :env `(("PREFIX" . ,(sb-posix:getenv "PREFIX"))))
    (buildah-run '("chmod" "777" "/usr/bin/core"))
    ;; (buildah-run '("mkdir" "-pv" "/opt/store/packy/dist/x86_64-unknown-linux-gnu" "/opt/store/packy/src")))
    )))
 (o2 ()
  (:build () (println "building o2 image")
   (with-buildah (c "o1" :commit "o2")
    (buildah-add (merge-env-pathnames "src/core.tar.zst" "PACKY_HOME") "/usr/src/")
    (buildah-add (merge-env-pathnames "zstd.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-zstd-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "sbcl.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-sbcl-pack.sh") :dir "/usr/src/infra/"))))
 (o3 ()
  (:build () (println "building o3 image")
   (with-buildah (c "o2" :commit "o3")
    (buildah-add (merge-env-pathnames "tree-sitter.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-tree-sitter-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "tree-sitter-langs.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-tree-sitter-langs-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "liburing.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-liburing-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "ublksrv.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-ublksrv-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "bzip2.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-bzip2-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "blake3.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-blake3-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "rocksdb.tar.zst" "PACKY_DIST_X86") "/usr/src/infra/.stash/cache/tmp/")
    (buildah-run '("sh" "scripts/install-rocksdb-pack.sh") :dir "/usr/src/infra/")
    (buildah-add (merge-env-pathnames "src/shed.tar.zst" "PACKY_HOME") "/usr/src/"))))
 (o ()
  (:build (build-o1 build-o2 build-o3))
  (:build-libs () 
   (info! "building all binary packs with output to .stash/")
   (with-container (c "o3" :name "libs-o" :tty t :run "/usr/bin/bash")
    (podman-exec '("skel" "make" "build-all")
     :dir "/usr/src/infra"
     :container "libs-o")
    ;; (podman-exec '("skel" "make" "dist-all")
    ;;  :dir "/usr/src/infra"
    ;;  :container "libs-o")
    (podman-cp "libs-o:/usr/src/infra/.stash/rocksdb.tar.zst" ".stash/")
    (podman-cp "libs-o:/usr/src/infra/.stash/sbcl.tar.zst" ".stash/")
    (podman-cp "libs-o:/usr/src/infra/.stash/zstd.tar.zst" ".stash/")
    (podman-cp "libs-o:/usr/src/infra/.stash/liburing.tar.zst" ".stash/")
    (podman-cp "libs-o:/usr/src/infra/.stash/tree-sitter.tar.zst" ".stash/")
    (podman-cp "libs-o:/usr/src/infra/.stash/tree-sitter-langs.tar.zst" ".stash/")))
  (:build-src ()
   (info! "building all source packs with output to ${PACKY_HOME}/src")
   (with-container (c "o1" :name "src-o" :detach t :tty t :run "bash")
    (podman-exec '("mkdir" "-pv" "/opt/store/packy/dist" "/opt/store/packy/src")
     :container "src-o")
    (flet ((cp1 (src dst) (podman-cp src (format nil "src-o:~A" dst) :overwrite t))
           (cp2 (src dst) (podman-cp (format nil "src-o:~A" src) dst :overwrite t)))
     (cp1 (merge-env-pathnames "infra/." "SRC") "/usr/src/infra")
     (cp1 (merge-env-pathnames "core/." "SRC") "/usr/src/core")
     (cp1 (merge-env-pathnames "demo/." "SRC") "/usr/src/demo")
     (cp1 (merge-env-pathnames "org/." "SRC") "/usr/src/org")
     (podman-exec '("skel" "make" "dist-all-source") 
      :dir "/usr/src/infra" 
      :container "src-o")
     (let ((src (merge-env-pathnames "src/" "PACKY_HOME")))
      (cp2 "/opt/store/packy/src/infra.tar.zst" src)
      (cp2 "/opt/store/packy/src/core.tar.zst" src)
      (cp2 "/opt/store/packy/src/demo.tar.zst" src)
      (cp2 "/opt/store/packy/src/org.tar.zst" src)))))))
